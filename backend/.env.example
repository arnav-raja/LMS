# Copy this file to .env and fill in real values. Never commit the real .env.

# Required. The app refuses to start without these two, rather than
# starting and then failing on the first request that needs them.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/learning_system
SECRET_KEY=replace-this-with-any-long-random-string

# Optional — shown with their defaults.
# Changing SECRET_KEY or ALGORITHM invalidates every token already issued,
# which signs everyone out.
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Comma-separated list of frontend origins allowed to call this API.
# Include your local dev server and your deployed frontend's real URL.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
